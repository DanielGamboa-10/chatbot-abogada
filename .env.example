# Clave de API de Google Gemini (Obtenla gratis en: https://aistudio.google.com/)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Modelo de Gemini a usar (recomendado: gemini-2.5-flash o gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Zona Horaria (Ejemplos: America/Bogota, America/Mexico_City, America/Lima, America/Santiago, America/Buenos_Aires, Europe/Madrid)
TIMEZONE=America/Bogota

# Modo estricto de horario: true = fuera de horario no usa IA y manda mensaje automático; false = IA atiende 24/7
ENABLE_SCHEDULE_RESTRICTION=true

# Tiempo de espera (en minutos) para no repetir el mensaje de fuera de horario al mismo usuario si sigue escribiendo
OFF_HOURS_COOLDOWN_MINUTES=60

# --- VINCULACIÓN POR NÚMERO DE TELÉFONO (PAIRING CODE) ---
# Si USE_PAIRING_CODE=true, no se usará código QR. Se generará un código de 8 dígitos para escribir en WhatsApp.
USE_PAIRING_CODE=true

# Número de WhatsApp de la abogada con código de país (sin el signo +, ej: 573001234567).
# Si lo dejas vacío, te lo pedirá en la consola al iniciar.
PHONE_NUMBER=
